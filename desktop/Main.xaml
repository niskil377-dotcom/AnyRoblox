<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Arma2OBJ Studio" Width="1110" Height="720" MinWidth="820" MinHeight="560" WindowStartupLocation="CenterScreen" Background="#171C21" Foreground="#E8EDF0" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#303941"/><Setter Property="Foreground" Value="#F4F7F8"/>
   <Setter Property="Padding" Value="13,8"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="bg" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#12171B"/><Setter Property="Foreground" Value="#EDF1F3"/><Setter Property="BorderBrush" Value="#48535C"/><Setter Property="Padding" Value="8,7"/><Setter Property="CaretBrush" Value="White"/></Style>
 </Window.Resources>
 <Grid>
 <DockPanel Name="Editor" Visibility="Collapsed">
  <Border DockPanel.Dock="Top" Background="#20272D" Padding="20,13"><DockPanel>
    <Button Name="OpenObj" Content="Ouvrir un OBJ…" DockPanel.Dock="Right"/>
    <Button Name="ChangeGame" Content="Changer de jeu" DockPanel.Dock="Right" Margin="0,0,8,0"/>
    <TextBlock Name="GameTitle" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
  </DockPanel></Border>
  <Border DockPanel.Dock="Bottom" Background="#161B20" Padding="14,8"><TextBlock Name="Status" Foreground="#BAC6CE" TextWrapping="Wrap" MaxHeight="78" Text="Prêt."/></Border>
  <Border DockPanel.Dock="Left" Width="300" Background="#20272D" Padding="16,19">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Name="Controls">
     <TextBlock Name="InputTitle" Text="Mods installés" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,7"/>
     <TextBlock Name="Instructions" TextWrapping="Wrap" Foreground="#BECBD2" Margin="0,0,0,10"/>
     <WrapPanel Name="ArmaLibrary" Margin="0,0,0,8"><Button Name="Refresh" Content="Actualiser" Margin="0,0,6,0"/><Button Name="Library" Content="Bibliothèque…"/></WrapPanel>
     <ComboBox Name="Mods" MinHeight="32" MaxDropDownHeight="290" ToolTip="Sélectionner un mod installé"/>
     <TextBlock Name="SourceHint" Margin="0,5,0,8" TextWrapping="Wrap" Foreground="#B7C4CA" FontSize="12" MaxHeight="48"/>
     <WrapPanel><Button Name="Folder" Content="Dossier…" Margin="0,0,8,0"/><Button Name="Archive" Content="PBO / ZIP…"/></WrapPanel>
     <Button Name="ConvertButton" Margin="0,10,0,0" Background="#A4E2CB" Foreground="#102A22" Content="Convertir" IsEnabled="False"/>
     <Border Height="1" Background="#364048" Margin="0,20,0,14"/>
     <TextBlock Text="Modèles" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,8"/>
    </StackPanel>
    <Button DockPanel.Dock="Bottom" Name="Results" Content="Ouvrir la sortie" Margin="0,12,0,0" IsEnabled="False"/>
    <ListBox Name="Models" Background="#1B2126" Foreground="#E8EDF0" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
   </DockPanel>
  </Border>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="#272E34" Padding="15,10"><DockPanel><Button DockPanel.Dock="Right" Name="Frame" Content="Recadrer  ·  F"/><StackPanel VerticalAlignment="Center"><TextBlock Name="TitleText" Text="Vue 3D" FontWeight="SemiBold" FontSize="17"/><TextBlock Name="Stats" Foreground="#B2BEC7" FontSize="12"/></StackPanel></DockPanel></Border>
   <Grid Grid.Row="1" Name="Scene" Background="#272D33"><TextBlock Name="Empty" Text="Les modèles convertis s’afficheront ici." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B6C1C9"/></Grid>
   <Border Grid.Row="2" Background="#21282E" Padding="14,10"><TextBlock Text="Molette  ·  Zoom      Clic molette + glisser  ·  Orbite      Maj + clic molette  ·  Déplacer" Foreground="#C2CDD4" TextWrapping="Wrap" FontSize="12"/></Border>
  </Grid>
 </DockPanel>
 <Grid Name="Home" Background="#171D22">
  <StackPanel Width="610" VerticalAlignment="Center" HorizontalAlignment="Center">
   <TextBlock Text="Studio OBJ" FontSize="38" FontWeight="SemiBold"/>
   <TextBlock Text="Quel jeu souhaitez-vous convertir ?" Foreground="#B9C7CF" FontSize="19" Margin="0,6,0,28"/>
   <UniformGrid Columns="2">
    <Button Name="ChooseFiveM" Background="#303941" Margin="0,0,6,0" Padding="22,25" HorizontalContentAlignment="Left">
     <StackPanel><TextBlock Text="FiveM → OBJ" FontSize="24" Foreground="#FFE4B7" FontWeight="SemiBold"/><TextBlock Text="Modèles YDR, YDD et YFT" Margin="0,8,0,0"/></StackPanel>
    </Button>
    <Button Name="ChooseArma" Background="#303941" Margin="6,0,0,0" Padding="22,25">
     <StackPanel><TextBlock Text="Arma 3 → OBJ" FontSize="24" Foreground="#A4E2CB" FontWeight="SemiBold"/><TextBlock Text="Mods locaux, PBO et ZIP" Margin="0,8,0,0"/></StackPanel>
    </Button>
   </UniformGrid>
  </StackPanel>
 </Grid>
 </Grid>
</Window>
