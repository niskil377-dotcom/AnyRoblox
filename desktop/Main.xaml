<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AnyRoblox — Any Games To Roblox" Width="1200" Height="760" MinWidth="820" MinHeight="570" WindowStartupLocation="CenterScreen" Background="#202020" Foreground="#E6E6E6" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EEEEEE"/><Setter Property="Background" Value="#454545"/><Setter Property="Padding" Value="11,6"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#535E6C"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="Background" Value="#365675"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#355571"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value=".46"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#E7E7E7"/><Setter Property="Padding" Value="8,3"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="Transparent"><StackPanel Orientation="Horizontal"><Path Data="M0,1 L12,1 L6,11 Z" Stroke="#EBAC67" StrokeThickness="1.4" Margin="0,3,8,0"/><ContentPresenter/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#375C80"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#48596A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#343434"/><Setter Property="Foreground" Value="#EEEEEE"/><Setter Property="Padding" Value="6,4"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#EEEEEE"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
   <Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#202020" BorderBrush="#505050" BorderThickness="1" CornerRadius="3"/></ControlTemplate></ToggleButton.Template></ToggleButton>
   <TextBlock Margin="8,3,22,3" IsHitTestVisible="False" VerticalAlignment="Center" Text="{Binding SelectedItem.Name,RelativeSource={RelativeSource TemplatedParent}}" TextTrimming="CharacterEllipsis"/>
   <TextBlock Text="▾" Foreground="#B0B0B0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"/>
   <Popup Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" Focusable="False"><Border Background="#343434" BorderBrush="#585858" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="250"><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
 <DockPanel Name="Editor">
  <Border DockPanel.Dock="Top" Background="#202020" Padding="10,5"><DockPanel>
   <Button DockPanel.Dock="Right" Name="ChangeGame" Content="Switch workspace" Padding="10,4"/>
   <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="AnyRoblox" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/><Border Background="#414141" CornerRadius="3" Padding="8,1"><TextBlock Name="GameTitle" Text="Workspace"/></Border></StackPanel>
    <TextBlock Text="Our goal is to bring 3D models from any game into Roblox." Margin="0,3,0,0"/><TextBlock Text="Currently supported: Arma 3 and FiveM for OBJ export, Arma Reforger for Workshop page inspection via CLI." FontSize="11" Foreground="#BEBEBE" TextWrapping="Wrap"/>
   </StackPanel>
  </DockPanel></Border>
  <Border DockPanel.Dock="Bottom" Background="#202020" Padding="10,4"><DockPanel><TextBlock DockPanel.Dock="Right" Foreground="#A5A5A5" FontSize="11" Text="MMB  Orbit     Shift + MMB  Pan     Wheel  Zoom" Margin="14,0,0,0"/><TextBlock Name="Status" FontSize="11" Foreground="#CDCDCD" Text="Ready" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/></DockPanel></Border>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="360"/><ColumnDefinition Width="4"/><ColumnDefinition Width="305" MinWidth="255" MaxWidth="480"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition/></Grid.RowDefinitions>
    <Border Background="#333333" Padding="10,3"><DockPanel><Button Name="Frame" DockPanel.Dock="Right" Content="Frame   F" Padding="8,2" ToolTip="Frame the current model"/><CheckBox Name="SolidToggle" DockPanel.Dock="Right" Content="Solid" ToolTip="Preview geometry with a solid surface" VerticalAlignment="Center" Foreground="#E3E3E3" Margin="0,0,12,0"/><CheckBox Name="GridToggle" DockPanel.Dock="Right" IsChecked="True" Content="Grid" VerticalAlignment="Center" Foreground="#E3E3E3" Margin="0,0,12,0"/>
     <StackPanel Orientation="Horizontal"><TextBlock Text="3D Viewport" VerticalAlignment="Center"/><Button Name="OpenObj" Content="Open OBJ…" Margin="18,0,0,0" Padding="8,2"/></StackPanel>
    </DockPanel></Border>
    <Grid Name="Scene" Grid.Row="1" Background="#3C3C3C">
     <StackPanel Margin="16,13" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"><TextBlock Text="User Perspective" FontWeight="SemiBold"/><TextBlock Name="TitleText" Text="Scene" Margin="0,2,0,0" Foreground="#DFDFDF"/><TextBlock Name="Stats" Foreground="#BCBCBC" FontSize="11"/></StackPanel>
     <TextBlock Name="Empty" Text="No model selected" IsHitTestVisible="False" Margin="16" VerticalAlignment="Bottom" Foreground="#BFBFBF"/>
    </Grid>
   </Grid>
   <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#1B1B1B"/>
   <Grid Grid.Column="2" Background="#303030"><Grid.RowDefinitions><RowDefinition Height="2*" MinHeight="110"/><RowDefinition Height="4"/><RowDefinition Height="4*" MinHeight="250"/></Grid.RowDefinitions>
    <DockPanel Background="#292929"><Border DockPanel.Dock="Top" Background="#383838" Padding="10,7"><TextBlock Text="Outliner" FontWeight="SemiBold"/></Border>
     <TextBlock DockPanel.Dock="Top" Text="▾   Scene Collection" Margin="10,8,0,3"/>
     <ListBox Name="Models" Margin="13,0,0,0" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></DockPanel>
    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#1B1B1B"/>
    <DockPanel Grid.Row="2"><Border DockPanel.Dock="Top" Background="#383838" Padding="10,7"><TextBlock Text="Conversion Properties" FontWeight="SemiBold"/></Border>
     <Button DockPanel.Dock="Bottom" Name="Results" Content="Open output folder" Margin="12,6,12,10" IsEnabled="False"/>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Name="Controls" Margin="12">
      <TextBlock Name="InputTitle" Text="Source" FontWeight="SemiBold" Foreground="#F0F0F0"/><TextBlock Name="Instructions" TextWrapping="Wrap" Foreground="#C8C8C8" FontSize="12" Margin="0,5,0,10"/>
      <WrapPanel Name="ArmaLibrary" Margin="0,0,0,7"><Button Name="Refresh" Content="Refresh" Margin="0,0,5,0"/><Button Name="Library" Content="Library…"/></WrapPanel>
      <ComboBox Name="Mods" MinHeight="28" ToolTip="Select a source"/><TextBlock Name="SourceHint" Margin="0,4,0,8" TextWrapping="Wrap" Foreground="#C1C1C1" FontSize="11" MaxHeight="44"/>
      <WrapPanel><Button Name="Folder" Content="Folder…" Margin="0,0,5,0"/><Button Name="Archive" Content="File…"/></WrapPanel>
      <Button Name="ConvertButton" Margin="0,12,0,0" Background="#426B94" Content="Convert to OBJ" IsEnabled="False"/>
     </StackPanel></ScrollViewer>
    </DockPanel>
   </Grid>
  </Grid>
 </DockPanel>
 <Grid Name="Home" Background="#B5181818"><Border Width="564" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#303030" BorderBrush="#5A5A5A" BorderThickness="1" CornerRadius="5">
  <StackPanel><TextBlock Text="AnyRoblox" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Our goal is to bring 3D models from any game into Roblox." Margin="0,4,0,4"/><TextBlock Text="Currently supported: Arma 3 and FiveM for OBJ export, Arma Reforger for Workshop page inspection via CLI." Foreground="#C8C8C8" TextWrapping="Wrap" Margin="0,0,0,20"/>
   <UniformGrid Columns="2"><Button Name="ChooseFiveM" Margin="0,0,5,0" Padding="12,18"><StackPanel><TextBlock Text="FiveM → OBJ" Foreground="#FFBD76" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="YDR, YDD and YFT models" Margin="0,4,0,0"/></StackPanel></Button><Button Name="ChooseArma" Margin="5,0,0,0" Padding="12,18"><StackPanel><TextBlock Text="Arma 3 → OBJ" Foreground="#A9CFFF" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Installed mods, PBO and ZIP" Margin="0,4,0,0"/></StackPanel></Button></UniformGrid>
  </StackPanel>
 </Border></Grid>
 </Grid>
</Window>
